{
  "service": {
    "root_path": "/api"
  },
  
  "live": {
    "session_ttl_s": 900,
    "session_preconnect_ttl_s": 30,
    "max_sessions": 12,
    "archive_ttl_s": 3600,
    "max_archives": 256,
    "audio": {
      "sample_rate_hz": 16000,
      "channels": 1
    },
    "timing": {
      "drain_wait_s": 20.0,
      "post_close_wait_s": 60.0,
      "emit_min_ms": 120
    },
    "asr": {
      "language": null,
      "beam_size": 5,
      "chunk_size": 10,
      "backend": "whisperx",
      "align_enabled": false,
      "diarize_enabled": false,
      "diarize_speaker_mode": "fixed",
      "diarize_min_speakers": 1,
      "diarize_max_speakers": 4
    },
    
    "rolling": {
      "min_infer_audio_ms": 500,
      "single_segment_commit_min_ms": 12000,
      "force_commit_repeats": 3,
      "max_uncommitted_ms": 30000,
      "hard_clip_keep_tail_ms": 5000,
      "max_decode_window_ms": 12000,
      "buffer_trim_threshold_ms": 30000,
      "buffer_trim_drop_ms": 20000,
      "min_new_audio_ms": 500,
      "pacing": {
        "base_emit_ms": 250,
        "startup": {
          "duration_ms": 1200,
          "emit_ms": 100,
          "min_infer_audio_ms": 250,
          "min_new_audio_ms": 200
        }
      },
      "vad": {
        "enabled": true,
        "whisperx_venv": "/home/gunnar/whisperx/.venv",
        "threshold": 0.35,
        "max_speech_duration_s": 12.0,
        "min_speech_ms": 120,
        "hangover_ms": 600
      },
      "speech_gate": {
        "silence_enter_ms": 900,
        "rearm_hits": 2,
        "rearm_window_ms": 500,
        "force_commit_silence_ms": 2500
      }
    }
  },

  "llm": {
    "pool": {
      "base_url": "http://127.0.0.1:8011"
    }
  },

  "upload": {
    "queue": {
      "prep_base": "data/jobs/upload_prep",
      "worker_base": "data/jobs/upload_worker"
    },
    "worker": {
      "progress_db_dir": "data/progress_db",
      "progress_runs_path": "data/progress_db/runs_v1.jsonl",
      "host_id": "",
      "hardware_key": ""
    },
    "coordinator": {
      "poll_interval_s": 0.5,
      "idle_log_interval_s": 30.0,
      "llm_wait_poll_s": 0.5,
      "llm_wait_timeout_s": 1800.0
    },
    "snip": {
      "minutes_default": 15
    },
    "topics": {
      "chunk_minutes": 15,
      "ctx_len": 16384,
      "ctx_safety": 0.85,
      "prompt_overhead_tokens_est": 1200,
      "token_estimator": "chars_div4",
      "enabled": true,
      "prompt_id": "topics_v1",
      "prompt_path": "portal-api/upload/prompts/simple_prompt5.txt",
      "model": "google_gemma-4-E4B-it-Q8_0-gguf",
      "generation": {
        "max_tokens": 2048,
        "temperature": 0.01,
        "top_p": 1,
        "top_k": 1,
        "repetition_penalty": 1
      }
    }
  },
  
  "asr_blob": {
    "root": "data/asr_blobs",
    "ttl_s": 3600,
    "cleanup_interval_s": 120,
    "cleanup_max_scan_files": 5000
  }
}
