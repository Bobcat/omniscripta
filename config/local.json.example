{
  "_comment": "Kopieer dit naar local.json en pas aan voor jouw workspace. local.json staat in .gitignore.",
  
  "service": {
    "port": 8001
  },
  
  "asr_pool": {
    "base_url": "http://127.0.0.1:18090",
    "status_url": "http://127.0.0.1:18090/asr/v1/pool",
    "timeouts": {
      "interactive": 60
    }
  },
  
  "live": {
    "_comment": "Ownership split: live.asr.* stays host-owned. live.rolling.* and live.timing.emit_min_ms tune the package runner.",
    "timing": {
      "_comment": "Package-owned pacing knob.",
      "emit_min_ms": 120
    },
    "asr": {
      "_comment": "Host-owned backend adapter knobs.",
      "backend": "whisperx",
      "beam_size": 5,
      "chunk_size": 10
    },
    "rolling": {
      "_comment": "Package-owned runner tuning knobs.",
      "min_infer_audio_ms": 1000,
      "force_commit_repeats": 3
    }
  },
  
  "upload": {
    "queue": {
      "prep_base": "data/upload/jobs/prep",
      "worker_base": "data/upload/jobs/worker"
    }
  },
  
  "frontend_dev": {
    "frontend_dir": "/home/gunnar/projects/omniscripta/static",
    "api_base": "http://127.0.0.1:8001",
    "host": "127.0.0.1",
    "port": 8010,
    "ws_buffer_bytes": 65536,
    "ws_idle_timeout_s": 1800.0
  }
}
