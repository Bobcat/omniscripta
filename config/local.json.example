{
  "_comment": "Kopieer dit naar local.json en pas aan voor jouw workspace. local.json staat in .gitignore.",
  
  "service": {
    "port": 8001
  },
  
  "asr_pool": {
    "base_url": "http://127.0.0.1:18090",
    "status_url": "http://127.0.0.1:18090/asr/v1/pool",
    "work_root": "/home/gunnar/projects/transcribe-dev/data/asr_pool",
    
    "timeouts": {
      "interactive": 60
    }
  },
  
  "live": {
    "rolling": {
      "min_infer_audio_ms": 1000,
      "force_commit_repeats": 3
    }
  },

  "polling_intervals": {
    "live_rolling_poll_ms": 250
  },
  
  "jobs": {
    "upload_prep_base": "data/jobs/upload_prep",
    "upload_worker_base": "data/jobs/upload_worker",
    "live_worker_base": "data/jobs/live_worker"
  },

  "worker": {
    "queue_base": "data/jobs/upload_worker",
    "max_outstanding_requests": 1
  },
  
  "frontend_dev": {
    "api_base": "http://127.0.0.1:8001"
  }
