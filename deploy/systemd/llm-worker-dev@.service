# User unit (systemctl --user). Generic LLM worker template.
[Unit]
Description=LLM Worker Dev (%i)

[Service]
Type=simple
WorkingDirectory=%h/projects/omniscripta/workers/llm
ExecStartPre=/usr/bin/mkdir -p %h/projects/omniscripta/data/llm_tasks/inbox %h/projects/omniscripta/data/llm_tasks/running %h/projects/omniscripta/data/llm_tasks/done %h/projects/omniscripta/data/llm_tasks/error
ExecStart=/srv/omniscripta/worker/.venv/bin/python %h/projects/omniscripta/workers/llm/daemon.py
Restart=always
RestartSec=2
EnvironmentFile=-%h/.config/transcribe/dev.env
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
