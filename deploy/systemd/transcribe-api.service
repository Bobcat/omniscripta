# /etc/systemd/system/transcribe-api.service
[Unit]
Description=Transcribe Portal API (FastAPI/Uvicorn)
After=network.target

[Service]
User=gunnar
Group=gunnar
WorkingDirectory=/srv/omniscripta/app
Environment="PATH=/srv/omniscripta/portal-api/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/srv/omniscripta/portal-api/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
