[Unit]
Description=Transcribe Worker Upload
After=network.target

[Service]
User=gunnar
Group=gunnar
WorkingDirectory=/srv/transcribe/worker
ExecStartPre=/usr/bin/mkdir -p /srv/transcribe/data/demo_jobs/inbox /srv/transcribe/data/demo_jobs/running /srv/transcribe/data/demo_jobs/done /srv/transcribe/data/demo_jobs/error
Environment=TRANSCRIBE_WORKER_MODE=upload
ExecStart=/srv/transcribe/worker/.venv/bin/python /srv/transcribe/worker/worker_daemon.py
Restart=always
RestartSec=2
Environment="WHISPERX_BIN=/home/gunnar/whisperx/.venv/bin/whisperx"
EnvironmentFile=/etc/transcribe/transcribe.env
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
