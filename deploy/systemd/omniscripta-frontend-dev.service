[Unit]
Description=Omniscripta Dev Frontend + /api Proxy
After=omniscripta-api-dev.service
Requires=omniscripta-api-dev.service

[Service]
EnvironmentFile=-/home/gunnar/.config/transcribe/dev.env
Type=simple
WorkingDirectory=/home/gunnar/projects/omniscripta
ExecStart=/usr/bin/python3 /home/gunnar/projects/omniscripta/deploy/dev_frontend_proxy.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
