[Unit]
Description=LLM Worker
After=network.target

[Service]
User=gunnar
Group=gunnar
WorkingDirectory=/srv/omniscripta/workers/llm
ExecStartPre=/usr/bin/mkdir -p /srv/omniscripta/data/upload/llm/tasks/inbox /srv/omniscripta/data/upload/llm/tasks/running /srv/omniscripta/data/upload/llm/tasks/done /srv/omniscripta/data/upload/llm/tasks/error
ExecStart=/srv/omniscripta/worker/.venv/bin/python /srv/omniscripta/workers/llm/daemon.py
Restart=always
RestartSec=2
EnvironmentFile=/etc/transcribe/transcribe.env
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
