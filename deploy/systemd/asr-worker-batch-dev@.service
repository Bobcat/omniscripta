# User unit (systemctl --user). Batch-only ASR worker template.
[Unit]
Description=ASR Worker Batch Dev (%i)

[Service]
Type=simple
WorkingDirectory=/home/gunnar/projects/transcribe-dev/asr-worker
ExecStartPre=/usr/bin/mkdir -p /home/gunnar/projects/transcribe-dev/data/demo_jobs/inbox /home/gunnar/projects/transcribe-dev/data/demo_jobs/running /home/gunnar/projects/transcribe-dev/data/demo_jobs/done /home/gunnar/projects/transcribe-dev/data/demo_jobs/error
Environment=ASR_WORKER_QUEUE_BASE=/home/gunnar/projects/transcribe-dev/data/jobs/upload_worker
Environment=ASR_WORKER_MAX_OUTSTANDING=1
Environment=ASR_WORKER_CONSUMER_ID=worker-batch@%i
ExecStart=/srv/transcribe/worker/.venv/bin/python /home/gunnar/projects/transcribe-dev/asr-worker/worker_daemon.py
Restart=always
RestartSec=2
EnvironmentFile=-%h/.config/transcribe/dev.env
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
