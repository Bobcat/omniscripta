[Unit]
Description=Transcribe Dev ASR Pool (Uvicorn)

[Service]
Type=simple
WorkingDirectory=/home/gunnar/projects/asr-pool
ExecStart=/home/gunnar/projects/asr-pool/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 18090
Restart=always
RestartSec=2
EnvironmentFile=-%h/.config/transcribe/dev.env

[Install]
WantedBy=default.target
