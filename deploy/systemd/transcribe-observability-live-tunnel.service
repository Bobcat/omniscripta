# Local user service for reaching live ops pages on dc1 without colliding with dev ports.
[Unit]
Description=SSH tunnel to live transcribe observability endpoints on dc1 (localhost:8000/8090/28110/28111)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N \
  -L 127.0.0.1:8000:127.0.0.1:8000 \
  -L 127.0.0.1:8090:127.0.0.1:8090 \
  -L 127.0.0.1:28110:127.0.0.1:18110 \
  -L 127.0.0.1:28111:127.0.0.1:18111 \
  dc1 \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=accept-new
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
